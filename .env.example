# Pet IoT Camera Service Configuration

# Service
PORT=3006

# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=your_username
# MQTT_PASSWORD=your_password

# Backend URLs
LOCAL_BACKEND_URL=http://localhost:3000
CLOUD_BACKEND_URL=https://api.petsmart.example.com
API_KEY=smart-pet-api-key-2026

# Streaming
STREAM_PORT=3007
HLS_OUTPUT=./streams

# Motion Detection
MOTION_THRESHOLD=30
MOTION_COOLDOWN=60

# Health Check
HEALTH_CHECK_INTERVAL=60000
